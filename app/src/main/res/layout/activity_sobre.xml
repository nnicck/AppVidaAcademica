<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SobreActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        app:title="Vida Acadêmica"
        app:titleTextColor="@color/white"
        app:titleCentered="true"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sobre"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSobre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="O Vida Acadêmica é um aplicativo criado para
auxiliar os estudantes na organização de sua rotina
escolar. Seu objetivo é facilitar o acompanhamento
das atividades acadêmicas, tornando o dia a dia
mais prático, organizado e produtivo."
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:gravity="start"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>