<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/white">

    <!-- Título -->
    <TextView
        android:id="@+id/tituloDisciplinas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="MINHAS DISCIPLINAS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Disciplina 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDisciplina1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/blue"
        app:cardCornerRadius="12dp"
        app:contentPadding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tituloDisciplinas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/nomeDisciplina1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programação para Dispositivos Móveis\n\nProfessor: Carlos Mendes"
            android:textSize="16sp"
            android:textColor="@color/white"/>

    </androidx.cardview.widget.CardView>

    <!-- Disciplina 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDisciplina2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/blue"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:contentPadding="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardDisciplina1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/nomeDisciplina2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Banco de Dados\n\nProfessor: Ana Oliveira"
            android:textSize="16sp"
            android:textColor="@color/white" />

    </androidx.cardview.widget.CardView>

    <!-- Disciplina 3 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDisciplina3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/blue"
        app:cardCornerRadius="12dp"
        app:contentPadding="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardDisciplina2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/nomeDisciplina3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programação Web\n\nProfessor: Roberto Santos"
            android:textSize="16sp"
            android:textColor="@color/white" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>